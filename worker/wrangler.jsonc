{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nutmeg-bot",
	"main": "src/index.ts",
	// 2026-10-16 作成。Python 版（Socket Mode）は branch python-socket-mode に凍結
	"compatibility_date": "2026-10-16",

	// バージョンごとの Preview URL を作らない。Slack と OpenAI の鍵を背負っているので、
	// 公開 URL は本番の1本だけに絞る（translation-ai と同じ設定）
	"preview_urls": false,

	// 誤って別アカウントへデプロイする事故を防ぐガード。
	// mtureit 個人アカウント（Mtureit@gmail.com's Account）。雲居アカウントには載せない
	"account_id": "4a114bfdd139e285794ff69108c5c5f9",

	// Python 側（index_build.py --target vectorize）が書き込む索引。
	// 2026-10-16 作成: 1536 次元（text-embedding-3-small）、cosine
	"vectorize": [{ "binding": "VECTORIZE", "index_name": "nutmeg-bot" }],

	// Slack の再送を弾く重複排除。キーは ev:<event_id>（5分）。2026-10-16 作成
	"kv_namespaces": [{ "binding": "DEDUP", "id": "076d1f28da284e08b2778aeb09de50a7" }],

	"vars": {
		// 答えるチャンネルをカンマ区切りで限定する。空 = 全チャンネル（Bot を招待した所だけ）
		"ALLOWED_SLACK_CHANNELS": "",
		// "true" で Slack のゲストにも答える
		"ALLOW_GUEST_USERS": "false"
	},

	"observability": { "enabled": true }
}
