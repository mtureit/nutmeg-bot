# Template for .env. Copy it and fill in the values:
#   cp sample.env .env && chmod 600 .env
# Never commit .env (it is in .gitignore). This file must stay free of real values.
# How to get each key: PLAN.md §12

# --- Notion ---
# Internal integration token from https://www.notion.so/my-integrations
# Capabilities: "Read content" only (turn off update / insert / comments)
NOTION_TOKEN=

# Root page IDs to ingest, comma-separated (the 32-char ID at the end of the page URL).
# Only pages under these roots are ingested. Each page also needs "Add connections" in Notion.
NOTION_ROOT_PAGE_IDS=

# --- OpenAI (embeddings, answers and image captions share this one key) ---
# https://platform.openai.com — set a monthly limit under Usage limits
OPENAI_API_KEY=

# --- Slack ---
# Bot token. Scopes: chat:write / app_mentions:read / users:read
SLACK_BOT_TOKEN=xoxb-
# Socket Mode app-level token. Scope: connections:write
SLACK_APP_TOKEN=xapp-

# --- Cloudflare (Worker version only: index_build.py --target vectorize) ---
# Account: Mtureit@gmail.com's Account
CLOUDFLARE_ACCOUNT_ID=4a114bfdd139e285794ff69108c5c5f9
# API token with only "Account > Vectorize > Edit" (https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=
VECTORIZE_INDEX=nutmeg-bot-512
